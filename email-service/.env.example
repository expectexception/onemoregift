NODE_ENV=production
PORT=8080

# Master switches.
EMAIL_SERVICE_ENABLED=true
EMAIL_REQUIRE_API_KEY=true
EMAIL_REQUIRE_SIGNATURE=true

# Required when EMAIL_REQUIRE_API_KEY=true.
# Use a long random value and use the same value in the main backend.
EMAIL_SERVICE_API_KEY=change_me_to_a_long_random_secret

# Required when EMAIL_REQUIRE_SIGNATURE=true.
# Use a second long random secret, different from EMAIL_SERVICE_API_KEY.
EMAIL_SERVICE_SIGNING_SECRET=change_me_to_a_second_long_random_secret
EMAIL_SIGNATURE_CLOCK_SKEW_SECONDS=300
EMAIL_SIGNATURE_NONCE_TTL_SECONDS=600
EMAIL_SIGNATURE_MAX_NONCES=5000

# Optional CORS allow-list. Keep empty for server-to-server only.
CORS_ORIGIN=

# Rate limit controls.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=120

# Endpoint switches. Disable anything you do not want exposed.
ENABLE_SEND_ENDPOINT=true
ENABLE_OTP_ENDPOINT=true
ENABLE_BULK_ENDPOINT=true
ENABLE_TEMPLATES_ENDPOINT=true
ENABLE_QUEUE_STATUS_ENDPOINT=true
ENABLE_SETTINGS_ENDPOINT=true

# Provider order. EMAIL_PROVIDER is tried first, then EMAIL_FALLBACK_PROVIDERS.
EMAIL_PROVIDER=smtp
EMAIL_FALLBACK_PROVIDERS=brevo
SMTP_ENABLED=true
BREVO_ENABLED=true

# Delivery mode:
# queue = respond fast, process email in background workers.
# sync = wait for provider response before API returns.
EMAIL_DELIVERY_MODE=queue
EMAIL_QUEUE_ENABLED=true
EMAIL_QUEUE_AUTOSTART=true
EMAIL_QUEUE_CONCURRENCY=3
EMAIL_QUEUE_MAX_SIZE=1000
EMAIL_QUEUE_RETRIES=2
EMAIL_QUEUE_RETRY_DELAY_MS=3000
EMAIL_QUEUE_KEEP_COMPLETED=100
EMAIL_QUEUE_KEEP_FAILED=100

SENDER_EMAIL=no-reply@onemoregift.in
SENDER_NAME=OneMoreGift

# Default brand/theme. Individual requests can override these with data.theme.
APP_NAME=OneMoreGift
APP_URL=https://onemoregift.in
SUPPORT_EMAIL=support@onemoregift.in
BRAND_PRIMARY=#ef4444
BRAND_ACCENT=#f97316

# Generic SMTP provider. For Brevo SMTP use smtp-relay.brevo.com.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_brevo_smtp_login
SMTP_PASS=your_brevo_smtp_key

# Brevo transactional REST API fallback. This must be an xkeysib API key, not an xsmtpsib SMTP key.
BREVO_API_KEY=your_brevo_xkeysib_api_key
