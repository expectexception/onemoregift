# OneMoreGift · generated by `omg activate`; edits here are overwritten on deploy.
# Template lives in deploy/dreamhost/shared/htaccess.
RewriteEngine On

# HTTPS only, and one canonical host.
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://onemoregift.in%{REQUEST_URI} [R=301,L]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://onemoregift.in%{REQUEST_URI} [R=301,L]

# Hand every request to the Next.js server. Next serves pages and its own
# /api/* routes, and forwards /api/v1, /uploads and /media to the backend.
<IfModule mod_headers.c>
  RequestHeader set X-Forwarded-Proto "https"
</IfModule>
RewriteRule ^(.*)$ http://127.0.0.1:__FRONTEND_PORT__/$1 [P,L]
