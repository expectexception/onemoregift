NODE_ENV=production
PORT=9000
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER_HOST/onemoregift?retryWrites=true&w=majority
JWT_SECRET=replace_with_64_plus_random_chars
# Encrypts user PII at rest. MUST be the same key the existing database was
# written with, or every user record becomes unreadable. Never rotate casually.
FIELD_ENCRYPTION_KEY=GENERATE_WITH_gen-keys.js
ROOT_ADMIN_EMAILS=admin@onemoregift.in
# Only these emails can log in to /admin. Leave empty and the whitelist is off.
ADMIN_EMAIL_WHITELIST=admin@onemoregift.in

CLIENT_URL=https://onemoregift.in
SERVER_URL=https://onemoregift.in
CORS_ORIGIN=https://onemoregift.in,https://www.onemoregift.in
COOKIE_DOMAIN=.onemoregift.in
POLICY_VERSION=2026-05-28

# Render email service integration.
EMAIL_SERVICE_ENABLED=true
EMAIL_SERVICE_REQUIRED=false
EMAIL_SERVICE_URL=https://your-email-service.onrender.com
EMAIL_SERVICE_API_KEY=use_the_same_value_as_render_EMAIL_SERVICE_API_KEY
EMAIL_SERVICE_SIGNING_ENABLED=true
EMAIL_SERVICE_SIGNING_SECRET=use_the_same_value_as_render_EMAIL_SERVICE_SIGNING_SECRET
EMAIL_SERVICE_TIMEOUT_MS=15000

# Optional fallback if the Render email service is unavailable.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@onemoregift.in
BREVO_SENDER_NAME=OneMoreGift
MAIL_USER=
MAIL_APP_PASSWORD=

# Google OAuth.
GOOGLE_CLIENT_ID=

NEXT_PUBLIC_ENABLE_GOOGLE_LOGIN=true