NODE_ENV=development
PORT=9000
MONGO_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/onemoregift?appName=onemoregift
JWT_SECRET=GENERATE_WITH_gen-keys.js
CLIENT_URL=http://localhost:3000
SERVER_URL=http://localhost:9000
CORS_ORIGIN=http://localhost:3000
COOKIE_DOMAIN=

# ── Encrypted .env at rest ─────────────────────────────────────────────────────
# In production, this file should be encrypted to .env.enc using:
#   node scripts/env-encrypt.js --key <APP_MASTER_KEY> --input .env --output .env.enc
# Then set APP_MASTER_KEY in PM2 ecosystem.config.cjs (never commit it).
# The app reads APP_MASTER_KEY from the process environment and decrypts .env.enc at startup.

# ── Field-level encryption ─────────────────────────────────────────────────────
# 64-char hex string (32 bytes). Generate with: node scripts/gen-keys.js
FIELD_ENCRYPTION_KEY=GENERATE_WITH_gen-keys.js

# ── Feature flags ──────────────────────────────────────────────────────────────
# Set to false to skip email OTP for user registration (auto-verify on sign up)
OTP_VERIFICATION_ENABLED=true

# Comma-separated admin emails allowed to access the admin panel.
# Leave empty to allow all valid admin tokens.
ADMIN_EMAIL_WHITELIST=admin@onemoregift.in

# Set to true to require email OTP (2FA) on every admin login
ADMIN_OTP_ENABLED=false

# ── Email service ──────────────────────────────────────────────────────────────
EMAIL_SERVICE_ENABLED=true
EMAIL_SERVICE_REQUIRED=false
EMAIL_SERVICE_URL=http://localhost:8080
EMAIL_SERVICE_API_KEY=GENERATE_WITH_gen-keys.js
EMAIL_SERVICE_SIGNING_ENABLED=true
EMAIL_SERVICE_SIGNING_SECRET=GENERATE_WITH_gen-keys.js
EMAIL_SERVICE_TIMEOUT_MS=15000

# ── Google OAuth ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_ENABLE_GOOGLE_LOGIN=true
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_IDS=your_google_client_id

# ── Admin bootstrap ────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=your_secure_password
ADMIN_USERNAME=RootAdmin
ROOT_ADMIN_EMAILS=admin@yourdomain.com

# ── Policy ─────────────────────────────────────────────────────────────────────
POLICY_VERSION=2026-05-28
