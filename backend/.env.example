NODE_ENV=development
PORT=9000
MONGO_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/onemoregift?appName=onemoregift
JWT_SECRET=GENERATE_WITH_gen-keys.js
CLIENT_URL=http://localhost:3000
SERVER_URL=http://localhost:9000
CORS_ORIGIN=http://localhost:3000
COOKIE_DOMAIN=

# ── Encrypted .env at rest ─────────────────────────────────────────────────────
# In production, this file should be encrypted to .env.enc using:
#   node scripts/env-encrypt.js --key <APP_MASTER_KEY> --input .env --output .env.enc
# Then set APP_MASTER_KEY in PM2 ecosystem.config.cjs (never commit it).
# The app reads APP_MASTER_KEY from the process environment and decrypts .env.enc at startup.

# ── Field-level encryption ─────────────────────────────────────────────────────
# 64-char hex string (32 bytes). Generate with: node scripts/gen-keys.js
FIELD_ENCRYPTION_KEY=GENERATE_WITH_gen-keys.js

# ── Feature flags ──────────────────────────────────────────────────────────────
# Set to false to skip email OTP for user registration (auto-verify on sign up)
OTP_VERIFICATION_ENABLED=true

# Comma-separated admin emails allowed to access the admin panel.
# Leave empty to allow all valid admin tokens.
ADMIN_EMAIL_WHITELIST=admin@onemoregift.in

# Set to true to require email OTP (2FA) on every admin login
ADMIN_OTP_ENABLED=false

# ── Email service ──────────────────────────────────────────────────────────────
EMAIL_SERVICE_ENABLED=true
EMAIL_SERVICE_REQUIRED=false
EMAIL_SERVICE_URL=http://localhost:8080
EMAIL_SERVICE_API_KEY=GENERATE_WITH_gen-keys.js
EMAIL_SERVICE_SIGNING_ENABLED=true
EMAIL_SERVICE_SIGNING_SECRET=GENERATE_WITH_gen-keys.js
EMAIL_SERVICE_TIMEOUT_MS=15000

# ── Google OAuth ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_ENABLE_GOOGLE_LOGIN=true
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_IDS=your_google_client_id

# ── Admin bootstrap ────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=your_secure_password
ADMIN_USERNAME=RootAdmin
ROOT_ADMIN_EMAILS=admin@yourdomain.com

# ── Shop / Payments ────────────────────────────────────────────────────────────
# Master switch for the shop checkout flow. Set to false to take the shop offline
# (product browsing still works, checkout/payment endpoints are disabled).
ENABLE_SHOP=true

# Set to true once a real gateway (Razorpay/Stripe) is wired in. Until then,
# checkout has no way to settle an online payment.
ENABLE_REAL_PAYMENTS=false

# Which payment backend to use. Only 'sandbox' is implemented today — this exists
# so a future real-gateway integration is a one-line switch, not a code change.
PAYMENTS_PROVIDER=sandbox

# The sandbox "mark this order paid" shortcut is a DEV-ONLY testing aid — it hands
# out paid orders to anyone who asks. It is force-disabled whenever
# NODE_ENV=production, and this flag can only turn it off further, never on.
ALLOW_SANDBOX_PAYMENTS=true

# NOTE: everything below acts as a DEFAULT — the admin panel (System Settings →
# Shop & Payments) can override each value live without a restart.

# Online payment gateway on/off (sandbox simulator included). Off = users pay via QR/COD.
ENABLE_PAYMENT_GATEWAY=false
# UPI QR payment: user pays on QR, uploads proof screenshot, admin verifies
ENABLE_QR_PAYMENTS=true
# Cash on pickup
ENABLE_COD=true
# UPI details shown to customers on the QR payment screen
PAYMENT_UPI_ID=yourupi@bank
PAYMENT_PAYEE_NAME=OneMoreGift
# WhatsApp number (with country code, e.g. 919876543210) where users drop payment screenshots
PAYMENT_WHATSAPP=

# Weekly drop cycle. Which weekday belongs to which stage is set in the admin panel
# (Control Centre → Shop & Drop); these are only the initial defaults.
# Weekday numbers, 0=Sun … 6=Sat. A day may appear in only one list; leftover days
# become the preparation stage.
SHOP_WEEKLY_DROP=true
DROP_PICKUP_DAYS=1,2
DROP_REVEAL_DAYS=3,4
DROP_SALE_DAYS=5,6

# How long customers are told they have to upload the payment screenshot
PAYMENT_PROOF_WINDOW_HOURS=6

# ── Public contact details (footer) — admin panel overrides these live ─────────
CONTACT_EMAIL=contact@onemoregift.in
CONTACT_PHONE=
CONTACT_WHATSAPP=
BUSINESS_ADDRESS=
INSTAGRAM_URL=

# Only 1 active surprise application per user
SURPRISE_ONE_ACTIVE_PER_USER=true

# ── Feature kill switches (defaults — admin panel overrides live) ──────────────
ENABLE_GIVEAWAYS=true
ENABLE_MOMENTS=true
ENABLE_SURPRISE=true

# Auto-cancel unpaid pending orders after N hours and restore stock (0 = off)
ORDER_AUTO_CANCEL_HOURS=24

# How many file backups scripts/backup-db.js keeps (cron: node scripts/backup-db.js)
BACKUP_KEEP=14

# ── Happy Moments moderation ───────────────────────────────────────────────────
# Number of user reports on a moment before it's auto-hidden pending admin review
MOMENT_REPORT_AUTOHIDE_THRESHOLD=5

# ── Media uploads ──────────────────────────────────────────────────────────────
MAX_IMAGE_SIZE_MB=5
MAX_VIDEO_SIZE_MB=25

# ── Policy ─────────────────────────────────────────────────────────────────────
POLICY_VERSION=2026-05-28
